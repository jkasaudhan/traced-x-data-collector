# ---------------------------------------------------------------------------
# Which database the CLI writes to. Local is the default everywhere; cloud is
# never implicit. Override per command with --db local|cloud.
# ---------------------------------------------------------------------------
DB_TARGET=local

# Local Postgres for development and for the test suite.
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/disinfo

# Supabase. Project Settings -> Database -> Connection string.
#
# Use the SESSION POOLER (port 5432), not the direct db.<ref>.supabase.co
# host: the direct host is IPv6-only and will not resolve on most home or
# office networks. The username is postgres.<project-ref>, not postgres.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# The TRANSACTION pooler (port 6543) also works — the code disables prepared
# statements automatically when it sees a pooled host — but session mode is
# the safer default for batch inserts.
#
# URL-encode the password if it contains @ : / ? # or %.
DATABASE_URL_CLOUD=

# Back-compat: used as the local URL if DATABASE_URL_LOCAL is unset.
# DATABASE_URL=

# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# https://dashboard.ngrok.com/get-started/your-authtoken (for make share)
NGROK_AUTHTOKEN=
